{
  "name": "message-check",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run build && npm run preview",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "build": "vite build && node scripts/intel.ts publish",
    "lint": "oxlint --deny-warnings src scripts tests playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/analysis.test.ts",
    "test:browser": "playwright test",
    "evaluate": "node tests/evaluation/run.ts",
    "evaluate:email": "node tests/evaluation/email-corpus.ts",
    "intel:sync": "node scripts/intel.ts sync",
    "intel:watch": "node scripts/intel.ts watch"
  },
  "dependencies": {
    "parse5": "8.1.1",
    "postal-mime": "4.2.0",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "oxlint": "1.92.0",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
